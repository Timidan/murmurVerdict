# Murmur Verdict — dashboard environment.
#
# Copy this file to `.env.local` for local dashboard development.
# Do not commit `.env`, `.env.local`, `.env.production`, or any file
# containing deployment-specific API URLs or secrets.

# Daemon HTTP API origin. Read by dashboard/src/verdict/api.ts at build
# time and baked into the Vite bundle, so this MUST be set in the Vercel
# project (or a sibling preview platform) — at runtime there is no
# fallback to the deployed origin.
#
# Local dev (run the daemon on the default port):
#   VITE_VERDICT_API_URL=http://localhost:8080
# Preview / prod (Render service URL):
#   VITE_VERDICT_API_URL=https://murmur-verdict.onrender.com
VITE_VERDICT_API_URL=

# Murmur Verdict — dashboard environment.
#
# Copy this file to `.env.local` for local dashboard development.
# Do not commit `.env`, `.env.local`, `.env.production`, or any file
# containing deployment-specific API URLs or secrets.

# Daemon HTTP API origin. Read by dashboard/src/verdict/api.ts at build
# time and baked into the Vite bundle, so this MUST be set in your
# static-host's project settings (Cloudflare Pages, Vercel, etc.). The
# client falls back to RELATIVE URLs when unset, which works in
# `npm run dashboard` (vite dev proxy) but produces a SPA that calls
# its own origin in production — usually wrong.
#
# Local dev (run the daemon on the default port):
#   VITE_VERDICT_API_URL=http://localhost:8080
# Preview / prod (your VPS daemon URL):
#   VITE_VERDICT_API_URL=https://api.murmur.example
VITE_VERDICT_API_URL=

# Phase 7 — Privy client app id. Mirror the backend PRIVY_APP_ID; this value
# is safe to expose (it's a public app identifier). Required for the casual-
# tier onboarding flow at #/account/login. When unset, public routes still
# render but the account area surfaces a "privy not configured" state.
VITE_PRIVY_APP_ID=

# Dashboard environment variables
#
# Copy this file to `.env.local` for local dashboard development.
# Do not commit `.env`, `.env.local`, `.env.production`, or any file containing
# deployment-specific API/RPC URLs or secrets.

# HTTP API base URL used by the dashboard for auth/config/trigger requests.
# Local development example:
# VITE_TRIGGER_URL=http://localhost:3001
VITE_TRIGGER_URL=

# WebSocket URL used by the dashboard for live loop snapshots.
# Local development example:
# VITE_WS_URL=ws://localhost:3001
VITE_WS_URL=

# Base Sepolia RPC endpoint used by wallet/read-contract flows.
# Prefer a project-specific RPC URL configured in your deployment platform.
# Public local/dev fallback example:
# VITE_BASE_RPC_URL=https://base-sepolia-rpc.publicnode.com
VITE_BASE_RPC_URL=

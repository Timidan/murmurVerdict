# Murmur Verdict — external agent example
# Copy to `.env` and fill in.

# Daemon URL (omit trailing slash). Defaults to localhost dev daemon.
MURMUR_API_URL=http://localhost:8080

# Pretty display name shown on the dashboard. Defaults to AGENT_SLUG.
AGENT_DISPLAY_NAME=External Momentum Agent

# Globally-unique slug. Lowercase, 3-32 chars, [a-z0-9-]. Pick something
# you control; this becomes /agents/<slug> publicly. The wallet binding
# enforces "you control this slug" — nobody else can claim it.
AGENT_SLUG=external-momentum-demo

# 0x-prefixed 64-hex Ethereum private key. The agent uses this ONLY to
# sign the wallet-only claim message; it's never sent to Murmur. The
# corresponding address is what every receipt is bound to going forward.
# CAIP-2 chain id default is eip155:8453 (Base mainnet).
WALLET_PRIVKEY=

# Market to submit to. eth.1h, eth.4h, eth.24h, eth.7d are seeded as
# 'listed' on the local daemon. New non-ETH markets ship 'draft' until
# an operator flips them.
MARKET_ID=eth.1h

# ═══════════════════════════════════════════════════════════════════════════
#  MURMUR DAEMON RUNTIME CONFIG
# ═══════════════════════════════════════════════════════════════════════════
#
# Everything in this section is read by the daemon at startup.
#
# Values that can be DERIVED are not here. Contract addresses and block
# heights come from data/deployments.json (kept current by
# `npm run sync:deployments`); the x402 binding domain comes from the Fhenix
# deployment. Those used to be env vars, and every one of them was a way for a
# stale copy to outlive a redeploy — which is exactly how a stale start block
# silently stopped reveal indexing on 2026-08-05.
#
# Deploy-time and host-level settings live at the BOTTOM of this file, clearly
# separated: the daemon never reads them.

# ─── Daemon ───────────────────────────────────────────────────────────────
PORT=8080
VERDICT_DB_PATH=./data/verdict.db

# Express trusts no forwarding headers by default, which is correct when the
# daemon port is directly reachable. Set this to the exact reverse-proxy hop
# count only when every request reaches Murmur through that trusted proxy.
MURMUR_TRUST_PROXY_HOPS=0

# CORS allowlist for the dashboard SPA — comma-separated origins permitted to
# call the daemon's /v1/* endpoints. Local dev: vite default 5173 / 5176.
DASHBOARD_ORIGIN=http://localhost:5173

# Where /share/:slug should redirect browsers AFTER serving social-scraper
# OG meta. The daemon trusts this string verbatim and emits a 0-second
# meta-refresh to it; never set it from a request header / query param.
# MURMUR_DASHBOARD_URL takes precedence; falls back to MURMUR_PUBLIC_URL
# for backwards compat. INTENTIONALLY unset by default — a self-hosted
# deploy without a dashboard origin must NOT silently redirect to localhost.
#   Local dev:    http://localhost:5173
#   Preview/prod: https://murmur-verdict.vercel.app
MURMUR_DASHBOARD_URL=

# Where the daemon ITSELF is publicly reachable. Used by /v1/openapi.json's
# `servers` block, /embed.js absolute URLs, and OpenServ launchpad links.
# Default points at the host-mapped port (8080) so a stock `docker compose up`
# emits links the host can hit. Set to your public daemon URL in prod.
MURMUR_PUBLIC_URL=http://localhost:8080

# Webhook delivery defaults to https-only. Set to "1" if you intentionally
# want to register http:// URLs from local dev (e.g. a localhost listener).
# Leave UNSET in production — the daemon ignores anything other than "1".
WEBHOOK_ALLOW_HTTP=

# ─── Cron tickers (seconds) ───────────────────────────────────────────────
RESOLVER_TICK_SEC=30

# ─── Resolution ──────────────────────────────────────────────────────────
# Murmur is a pure referee over EXTERNAL prediction markets: the venue
# resolves its own market and Murmur scores the sealed call against that
# outcome. There is no price-oracle configuration — the resolver ticks
# unconditionally and reads outcomes through the venue adapter
# (Polymarket Gamma, with the CLOB fallback for closed micro-markets).

# ─── OpenServ Launchpad agent (optional public discovery) ─────────────────
# OpenServ is not in the request, reveal, scoring, persistence, or payout
# path. It defaults on when OPENSERV_API_KEY is present; explicitly setting
# OPENSERV_LAUNCHPAD_ENABLED=true without a key fails daemon boot.
OPENSERV_API_KEY=
OPENSERV_AUTH_TOKEN=
OPENSERV_LAUNCHPAD_PORT=7378
OPENSERV_LAUNCHPAD_ENABLED=false
OPENSERV_LAUNCHPAD_PROJECT_ID=
OPENSERV_LAUNCHPAD_PROJECT_URL=
OPENSERV_LAUNCHPAD_STAGE=prelaunch

# ─── Privy (REQUIRED in production for account-owned agents) ─────────────
# Without these, Privy bearer auth fails closed. API-key auth still works
# for agents that already minted keys.
#
# JWKS by default: PRIVY_VERIFICATION_KEY is OPTIONAL. Leave blank and the
# SDK fetches + caches `auth.privy.io/v1/apps/<APP_ID>/jwks.json` (60-min
# cache, 10-min cooldown) so Privy can rotate signing keys without a
# redeploy. Only set it to pin verification to a specific PEM (defense
# against upstream-compromise scenarios or air-gapped audits).
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_VERIFICATION_KEY=

# Inbound Privy "Login method transfer" receiver (POST /v1/privy/webhooks).
# Set to the Privy dashboard endpoint signing secret (`whsec_...`, passed
# through unchanged) to enable account-transfer reparenting: when Privy moves a
# login to a new user and deletes the old one, the signed webhook reparents
# Murmur ownership from the source DID's account to the destination's. Leave
# blank and the receiver fails closed (route returns 503). When set,
# PRIVY_APP_ID + PRIVY_APP_SECRET are REQUIRED (the verifier needs the Privy
# client to check the svix signature) or the daemon refuses to start.
PRIVY_WEBHOOK_SIGNING_SECRET=

# ─── Admin routes ────────────────────────────────────────────────────────
# Required for admin Fhenix reveal ingest, Gateway relayer control,
# and sender cleanup routes.
VERDICT_ADMIN_TOKEN=

# ─── Privacy: sealed Fhenix submission ───────────────────────────────────
# Sealed Fhenix is the only submission mode. The daemon never receives
# pending binary-index/confidence plaintext; it verifies submit/reveal
# events against the Fhenix chain before storing public metadata.
#
# Fhenix chain verification. POST /v2/gateway/calls,
# POST /v2/gateway/feeds/:id/packets, and POST /v1/admin/fhenix/reveals fail
# closed unless Murmur can verify the corresponding contract event through
# this RPC. (Public /v1/calls and /v2/calls are retired and always return
# 410.) The canonical MurmurSealedVerdicts deployment is allowlisted from
# data/deployments.json (or FHENIX_SEALED_VERDICTS_ADDRESS); without it,
# arbitrary same-ABI contracts are not production-safe.
#
# IMPORTANT: FHENIX_RPC_URL (and FHENIX_WATCHER_RPC_URL if set) MUST serve
# archive eth_getLogs back to the contract's deploy block. The reveal watcher
# replays historical VerdictRevealed/VerdictRevealInvalid logs, so a non-archive
# endpoint breaks reveal ingestion: publicnode's free tier does NOT work (old
# ranges return "pruned history unavailable"; recent ranges return "Archive
# requests require a personal token"). drpc, Tenderly, and Alchemy do serve it.
FHENIX_RPC_URL=
# Optional dedicated RPC for the reveal watcher's eth_getLogs / head reads.
# Empty = reuse FHENIX_RPC_URL. Point this at an archive endpoint when your
# primary FHENIX_RPC_URL (used by the verifier for receipts) cannot serve
# archive eth_getLogs across the full history.
FHENIX_WATCHER_RPC_URL=
# OPTIONAL. Where the deployment manifest lives. Empty = data/deployments.json
# under the working directory. The chain id and contract addresses are read
# from here, so pointing it somewhere unexpected changes both.
DEPLOYMENTS_MANIFEST_PATH=
# OPTIONAL. Derived from the manifest above when it describes one chain, which
# is the normal case. Set it only for a multi-chain manifest, or to be
# explicit — and it must then agree with the manifest, or startup refuses.
FHENIX_CHAIN_ID=
FHENIX_EVENT_TICK_SEC=30
FHENIX_EVENT_CONFIRMATIONS=2
FHENIX_EVENT_BATCH_SIZE=1000
# Overdue-alert grace only. The watcher NO LONGER auto-marks reveals `missed`
# (a sealed call is revealable forever); this is the age past reveal_open_at
# after which an unrevealed pending call raises a warning operator alert
# (fhenix_reveal_fallback_overdue), escalating to critical ~30 min later.
FHENIX_REVEAL_GRACE_SEC=3600

# ── Murmur-owned FALLBACK reveal worker (calls only) ─────────────────────────
# Default OFF. When enabled, a DEDICATED reveal EOA guarantees every sealed
# CALL is publicly revealed after the agent grace window: openReveal → threshold
# decrypt → publishReveal (both are permissionless). This EOA must be its OWN
# key — NOT FHENIX_GATEWAY_RELAYER_PRIVATE_KEY (avoids nonce contention) — and
# exactly ONE write-enabled process may run per reveal EOA (see DEPLOYMENT.md).
# A publish tx sent by this key is attributed as a daemon_fallback reveal on the
# leaderboard; agent self-reveals stay attributed to the agent.
# NOTE: feed-packet reveal is intentionally out of scope for this worker.
# ── Paid decrypt-grant (Flow 2) ──────────────────────────────────────────────
# Sells a subscriber EARLY private decrypt access to a sealed call, before the
# public reveal. Default OFF. The grant EOA must be its OWN key — NOT the
# gateway relayer — and must hold the on-chain grantor role (set at deploy via
# GRANTOR_ADDRESS, or later with setGrantor).
# REQUIRED to enable paid grants. Murmur has no automated refund worker: a
# grant that fails AFTER payment settles is recorded as grant_failed_refund_due
# and must be refunded by hand (see entitlementsRepo.listRefundDue). Set this
# only if you have an operator process that actually honours that.
MURMUR_ACK_MANUAL_REFUNDS=false
FHENIX_GRANT_ENABLED=false
FHENIX_GRANT_PRIVATE_KEY=
# Crash recovery for in-flight grants. Enabling grants WITHOUT this leaves a
# settled payment stranded after a restart, with no path to grant or refund.
FHENIX_GRANT_RECONCILER_ENABLED=false
FHENIX_GRANT_RECONCILER_TICK_SEC=30
FHENIX_GRANT_CONFIRMATIONS=2
# Grant delivery tuning. Defaults shown; all optional.
#   MAX_ATTEMPTS      broadcasts before a settled-but-ungrantable row is owed a
#                     refund. Raising it delays the refund; lowering it declares
#                     one sooner.
#   REBROADCAST_DELAY grace before an unmined grant tx is presumed dropped. Also
#                     how long a reservation is left alone while its request is
#                     still settling, so keep it above a payment round-trip.
#   SETTLEMENT_UNKNOWN_MAX_ATTEMPTS
#                     reconcile passes an ambiguous settlement survives before it
#                     is conservatively marked refund_due rather than stranded.
FHENIX_GRANT_MAX_ATTEMPTS=5
FHENIX_GRANT_REBROADCAST_DELAY_SEC=30
FHENIX_GRANT_SETTLEMENT_UNKNOWN_MAX_ATTEMPTS=8
# Sales stop this many seconds before the CONTRACT's grant deadline, so a
# payment is never settled for a grant that will revert. Lower it and you sell
# closer to the edge; 0 means selling right up to the deadline.
FHENIX_GRANT_SALES_SAFETY_SEC=180
# Startup warns when the grantor EOA holds less than this. Grants are one tx
# each, so an unfunded grantor takes payments it cannot deliver. 0.02 ETH.
FHENIX_GRANT_MIN_BALANCE_WEI=20000000000000000
# Access price in the settlement asset's ATOMIC units, and its currency. No
# default: a price is a commercial decision and must be stated explicitly.
FHENIX_GRANT_PRICE_ATOMS=
FHENIX_GRANT_CURRENCY=
# REQUIRED with grants. Identifies the commercial terms a subscriber agreed
# to, so it is stated rather than defaulted.
FHENIX_GRANT_PRICING_VERSION=

# Max subscribers per call. Enforced BEFORE the 402 challenge, so a call that
# is already full is never charged for.
#
# This is an OPERATIONAL SALES LIMIT, not a gas bound. Each grant is its own
# transaction (there is no batch-grant entrypoint), so a large cohort does not
# risk exceeding a block — it costs N transactions, which is a grantor FUNDING
# question. Size this from how much you are willing to spend per call and how
# many grants can confirm inside the delivery budget, not from a block limit.
# For the per-grant gas to budget against, measure it on your target network —
# contracts/test/MurmurSealedVerdicts.t.sol:test_measureGrantGasPerSubscriber
# reports it, but only against the CoFHE mock, whose gas differs from
# production.
#
# Must match the series' max_armed_per_call, which is what registration
# persists; eligibility prefers the series value and uses this only as a
# fallback when the call's market cannot be resolved.
FHENIX_GRANT_MAX_ARMED_PER_CALL=

FHENIX_REVEAL_WORKER_ENABLED=false
FHENIX_REVEAL_PRIVATE_KEY=
# Agent-exclusive grace after reveal_open_at (chain time) before the worker
# reveals. Keeps the agent-vs-fallback distinction meaningful.
FHENIX_REVEAL_WORKER_GRACE_SEC=300
FHENIX_REVEAL_WORKER_TICK_SEC=30
FHENIX_REVEAL_WORKER_CONFIRMATIONS=2
FHENIX_REVEAL_WORKER_MAX_JOBS_PER_TICK=5
FHENIX_REVEAL_WORKER_MAX_CONCURRENCY=2
# Backoff sequence ~5,10,20,30,60s then cap. No terminal max-attempt count —
# the worker retries indefinitely and escalates via alerts instead of giving up.
FHENIX_REVEAL_WORKER_RETRY_BASE_MS=5000
FHENIX_REVEAL_WORKER_RETRY_MAX_MS=300000
# How long a broadcast open/publish tx may sit with no receipt before the worker
# re-broadcasts it. A dropped or nonce-gapped reveal tx never produces a receipt,
# so this watermark is what lets the worker self-heal instead of waiting forever.
FHENIX_REVEAL_WORKER_REBROADCAST_MS=90000
# Worker-health escalation thresholds (age past reveal_open_at).
FHENIX_REVEAL_WORKER_WARN_SEC=600
FHENIX_REVEAL_WORKER_ESCALATE_SEC=1800
# Startup warns if the reveal EOA balance is below this (fund before first use).
FHENIX_REVEAL_WORKER_MIN_BALANCE_WEI=20000000000000000
# The ciphertext is public after openReveal, so the SDK .withoutPermit() decrypt
# path can drop the permit lifecycle. Default false uses the proven permit path.
FHENIX_REVEAL_WORKER_WITHOUT_PERMIT=false

# Optional Gateway tx broadcaster. When enabled, agents can call
# POST /v2/gateway/calls or /v2/gateway/feeds/:feed_id/packets with
# X-Murmur-Runtime-Key and already-created CoFHE encrypted inputs; Murmur
# relays submitSealedFor/submitFeedPacketFor with this relayer key.
FHENIX_GATEWAY_ENABLED=false
FHENIX_GATEWAY_RELAYER_PRIVATE_KEY=
MURMUR_ACK_FEED_REVEAL_MANUAL=false
MURMUR_OWNED_SEALING_ENABLED=false
FHENIX_GATEWAY_TICK_SEC=10
FHENIX_GATEWAY_CONFIRMATIONS=2
FHENIX_GATEWAY_RETRY_BASE_MS=5000
FHENIX_GATEWAY_RETRY_MAX_MS=120000
# OPTIONAL. Block to search from when a broadcast attempt's tx cannot be found
# — a relay that was mined under a different hash is still recoverable by
# scanning logs from here. Empty skips the search, and the attempt's terminal
# error says so rather than implying the tx does not exist. Set it to the
# contract's deploy block if you want that recovery.
FHENIX_RECONCILE_OLD_FROM_BLOCK=
FHENIX_GATEWAY_MAX_ATTEMPTS=5
FHENIX_GATEWAY_STUCK_SEC=600
FHENIX_GATEWAY_BROADCAST_TIMEOUT_MS=90000

# Long-running feed SLA enforcement. Records missed expected feed packets
# for listed cadence feeds; does not execute payment refunds.
FEED_SLA_TICK_SEC=60

# Operator live canaries + Polymarket Gamma sync. Both default ON — Gamma is
# a public key-less API. Fhenix canary auto-enables when FHENIX_RPC_URL and
# FHENIX_CHAIN_ID are set; the Polymarket canary follows the Gamma sync flag
# and checks either this conditionId or the first listed Polymarket market in
# the DB. Set an explicit =false only to opt out.
LIVE_CANARY_TICK_SEC=300
FHENIX_CANARY_ENABLED=
FHENIX_CANARY_REQUIRE_CONTRACT_CODE=true
MURMUR_POLYMARKET_GAMMA_ENABLED=
POLYMARKET_CANARY_ENABLED=
POLYMARKET_CANARY_CONDITION_ID=
MURMUR_REQUIRE_LIVE_CANARIES=false

# Polymarket 5-minute market auto-discovery. Default OFF. Discovers imminent
# crypto "Up or Down" windows via Gamma and registers each one in the DB
# (staged draft -> listed only after verified chain confirmation) AND
# on-chain via registerMarket, signed with the owner/relayer key
# (FHENIX_GATEWAY_RELAYER_PRIVATE_KEY). Enabling therefore requires
# FHENIX_GATEWAY_ENABLED=true and MURMUR_POLYMARKET_GAMMA_ENABLED not false;
# invalid combinations refuse to start. Exactly ONE write-enabled daemon
# replica may hold this key — the in-process nonce queue cannot coordinate
# across replicas. Every registration costs ~100-150k gas; the per-tick /
# per-hour / per-day caps and the balance reserve bound the spend.
POLYMARKET_DISCOVERY_ENABLED=false
POLYMARKET_DISCOVERY_TICK_SEC=60
POLYMARKET_DISCOVERY_LOOKAHEAD_MIN=20
POLYMARKET_DISCOVERY_MIN_LEAD_SEC=120
POLYMARKET_DISCOVERY_QUESTION_FILTER='Up or Down'
POLYMARKET_DISCOVERY_ASSETS=Bitcoin,Ethereum
# Exact endDate-startDate duration; 300 selects the 5-minute series and
# rejects the 15-minute rows that share the same question shape.
POLYMARKET_DISCOVERY_WINDOW_DURATION_SEC=300

# Series clock. Every on-chain instant derives from the market's endDate:
#   armCloseAt          = endDate - window - openLead - commitMargin
#   submissionOpenAt    = endDate - window - openLead
#   earlyAccessCutoffAt = endDate - window - deliveryBudget
#   submissionCloseAt   = endDate - window          (prediction window start)
#   publicRevealAt      = endDate + embargo
# Validated at boot: all > 0, and OPEN_LEAD must be strictly greater than
# DELIVERY_BUDGET or there is no window in which a sellable call can be made.
POLYMARKET_DISCOVERY_SUBMISSION_OPEN_LEAD_SEC=300
# Ordering margin between arm close and submissions opening, so the cohort
# commit transaction cannot be mined after a provider's submit.
POLYMARKET_DISCOVERY_COMMIT_MARGIN_SEC=60
# Headroom reserved before the window opens for granting + subscriber decrypt.
# Sized from the measured CoFHE pipeline (~8-35s); calls submitted after
# earlyAccessCutoffAt are still refereed and scored, just never sold.
POLYMARKET_DISCOVERY_DELIVERY_BUDGET_SEC=60
# How long after market resolution the sealed value stays private.
POLYMARKET_DISCOVERY_EMBARGO_SEC=600
# Bump to intentionally adopt new SERIES TERMS: the clock constants above AND
# the cohort cap below. Both are immutable for a series id — existing markets
# keep what they were registered with; new markets bind to the new series.
# Changing either without bumping this fails the discovery preflight every
# tick, on purpose.
#
# To change the cohort cap: set FHENIX_GRANT_MAX_ARMED_PER_CALL and
# POLYMARKET_DISCOVERY_MAX_ARMED_PER_CALL to the new value AND bump this.
# Markets already registered keep selling under the old cap, which is the
# point — subscribers armed against it.
POLYMARKET_DISCOVERY_SERIES_VERSION=1
POLYMARKET_DISCOVERY_MAX_PER_TICK=4
POLYMARKET_DISCOVERY_MAX_PER_HOUR=30
POLYMARKET_DISCOVERY_MAX_PER_DAY=650
POLYMARKET_DISCOVERY_MIN_BALANCE_WEI=50000000000000000
POLYMARKET_DISCOVERY_WARN_BALANCE_WEI=200000000000000000
POLYMARKET_DISCOVERY_MAX_REGISTER_COST_WEI=500000000000000

# Live venue ticker — the public market board's price feed. Holds one
# read-only websocket to Polymarket's public CLOB market stream for the
# markets this daemon tracks, and serves them on GET /v2/venue/stream (SSE)
# and GET /v2/venue/live (snapshot). Display only: murmur's own verdicts come
# from the resolver and never from this feed.
#
# DERIVED, not required: it is on exactly when POLYMARKET_DISCOVERY_ENABLED is
# on, because a deployment that registers no Polymarket markets has nothing to
# stream. Set this to false to keep discovery while dropping the socket (both
# routes then answer 503). Accepts true/1/yes and false/0/no.
MURMUR_VENUE_TICKER_ENABLED=

# Operator alerts. Alerts are always persisted locally and surfaced in
# /v1/admin/alerts. Set the webhook URL to POST deduplicated Gateway, Fhenix
# lifecycle, feed SLA, identity, and live-canary alerts to an incident channel.
OPERATOR_ALERT_TICK_SEC=60
MURMUR_OPERATOR_ALERT_WEBHOOK_URL=
MURMUR_OPERATOR_ALERT_SECRET=
MURMUR_OPERATOR_ALERT_TIMEOUT_MS=5000

# CoFHE / Fhenix coprocessor on Base Sepolia
# TaskManager 0xeA30c4B8b44078Bbf8a6ef5b9f1eC1626C7848D9 (deterministic across CoFHE chains)
# The relayer key for sealed-call submissions is FHENIX_GATEWAY_RELAYER_PRIVATE_KEY (above).
FHENIX_SEALED_VERDICTS_ADDRESS=
FHENIX_ESCROW_ADDRESS=

# ─── Nanopayments (off by default) ───────────────────────────────────────
# Enabling this configures the SETTLEMENT RAIL — who gets paid, on which
# network, under which binding domain. Two separate products ride that rail:
#
#   · paid inference   → POST /v2/nanopay/infer/:pipelineId, priced by
#                        MURMUR_NANOPAY_DEFAULT_PRICE below
#   · paid decrypt-grants → POST /v2/gateway/calls/:callId/access, priced by
#                        FHENIX_GRANT_PRICE_ATOMS
#
# Selling ONLY decrypt-grants? Set MURMUR_NANOPAY_ENABLED=true with the seller
# and domain below, and leave MURMUR_NANOPAY_DEFAULT_PRICE blank. The rail is
# configured, grants work, and the inference route simply does not mount.
#
# ── The split: murmur's cut of an early-access sale ──────────────────────
# Basis points of every decrypt-grant sale that murmur keeps. The rest accrues
# to the agent owner whose signal was sold.
#
#     1000  →  murmur 10% / provider 90%
#      300  →  murmur  3% / provider 97%
#        0  →  murmur takes nothing
#    10000  →  murmur takes everything
#
# REQUIRED when FHENIX_GATEWAY_ENABLED=true OR FHENIX_GRANT_ENABLED=true.
# Grants are the obvious case. The GATEWAY needs it too because sealing a call
# is what freezes the split onto that call — a selling call sealed while grants
# were off must still carry the terms it will be sold under.
#
# NO DEFAULT, deliberately. A fee is a business decision: a hidden 0 gives the
# whole sale away and a hidden 10% takes it, and both read as intentional in
# every ledger row they produce. Changing it later affects calls sealed FROM
# THEN ON; calls already sealed keep the split they were offered under, the
# same rule the provider's own price follows.
#
# WHERE THE MONEY ACTUALLY GOES: nowhere new. Circle settles to one recipient,
# so 100% of every sale still lands at MURMUR_NANOPAY_SELLER_ADDRESS. This
# number decides what the LEDGER records as the provider's
# (GET /v1/account/agents/:slug/earnings). Paying providers out of that balance
# is a manual operator step today, exactly like refunds.
MURMUR_PROTOCOL_FEE_BPS=
MURMUR_NANOPAY_ENABLED=false
MURMUR_NANOPAY_NETWORK=testnet
MURMUR_NANOPAY_SELLER_ADDRESS=
# Price for paid INFERENCE. Blank = the inference route does not mount (grants
# are unaffected). No default — a hidden fallback would charge real users a
# price nobody chose. Must be > $0, and if MURMUR_NANOPAY_PIPELINES is set,
# every entry must match it.
# QUOTE THIS. The value starts with `$`, and DEPLOYMENT.md tells operators to
# `set -a; . ./.env` before deploying — an unquoted $0.001 then expands to the
# shell's $0 (the script path) and the daemon refuses to start on a price it
# cannot parse. Observed for real.
MURMUR_NANOPAY_DEFAULT_PRICE=
MURMUR_NANOPAY_ACCEPT_NETWORKS=
MURMUR_NANOPAY_PIPELINES=
MURMUR_NANOPAY_PIPELINE_AGENT_MAP=

# Runtime-key PoP audience — set a deployment-unique value (e.g. murmur-prod)
# so signed gateway requests cannot replay across deployments sharing key
# material (staging restores, DB clones). Default: murmur-gateway.
# MURMUR_POP_AUDIENCE=murmur-gateway

# ═══════════════════════════════════════════════════════════════════════════
#  NOT READ BY THE DAEMON
# ═══════════════════════════════════════════════════════════════════════════
#
# Everything below is consumed by something OTHER than the murmur daemon, and
# is kept here only so one `set -a; . ./.env` covers a deploy. The daemon
# ignores all of it. Nothing here needs to be set to run murmur.

# ─── Contract deployment (Foundry scripts) ────────────────────────────────
# Read by contracts/script/Deploy*.s.sol at deploy time. See DEPLOYMENT.md.
#
# RELAYER_ADDRESS, GRANTOR_ADDRESS and REVEAL_ADDRESS are NOT set here — they
# are derived from the private keys above by:
#
#     eval "$(npx tsx tools/print-deploy-env.ts)"
#
# Solidity cannot derive an address from a key, so somebody has to compute
# them; doing it by hand is what produced a documented snippet referencing
# `$GRANT_ADDRESS`, a variable defined nowhere, which exported an empty
# grantor and reverted the deploy.
#
# PROTOCOL_FEE_SINK stays explicit: where fees go is a business decision, not
# a key's identity, and deriving it from whatever key is in scope is how money
# quietly lands somewhere nobody chose.
PROTOCOL_FEE_SINK=


# ─── Host / backup (docker-compose, litestream) ───────────────────────────
# Read by docker-compose.yml and the litestream sidecar, never by the daemon.
NODE_ENV=
# ─── Litestream — continuous SQLite WAL replication to off-host storage ──
# Required for any production deploy. The litestream sidecar in
# docker-compose.yml uses these to authenticate against your S3-compatible
# bucket. The bucket/endpoint/region live in litestream.yml (NOT here) so
# they can be edited without rebuilding the .env. See DEPLOYMENT.md for
# the per-provider walkthrough (Backblaze B2 / Cloudflare R2 / S3 / MinIO).
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
# UID:GID the litestream container runs as. Must match the daemon's user
# (node:22-slim uses uid=1000, gid=1000). Override only if you've forked
# the daemon Dockerfile to a different runtime user.
LITESTREAM_USER=1000:1000

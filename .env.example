# ─── Daemon ───────────────────────────────────────────────────────────────
PORT=8080
VERDICT_DB_PATH=./data/verdict.db

# CORS allowlist for the dashboard SPA — comma-separated origins permitted to
# call the daemon's /v1/* endpoints. Local dev: vite default 5173 / 5176.
DASHBOARD_ORIGIN=http://localhost:5173

# Where /share/:slug should redirect browsers AFTER serving social-scraper
# OG meta. The daemon trusts this string verbatim and emits a 0-second
# meta-refresh to it; never set it from a request header / query param.
# MURMUR_DASHBOARD_URL takes precedence; falls back to MURMUR_PUBLIC_URL
# for backwards compat. INTENTIONALLY unset by default — a self-hosted
# deploy without a dashboard origin must NOT silently redirect to localhost.
#   Local dev:    http://localhost:5173
#   Preview/prod: https://murmur-verdict.vercel.app
MURMUR_DASHBOARD_URL=

# Where the daemon ITSELF is publicly reachable. Used by /v1/openapi.json's
# `servers` block, /embed.js absolute URLs, Telegram resolution-card links.
# Default points at the host-mapped port (8080) so a stock `docker compose up`
# emits links the host can hit. Set to your public daemon URL in prod.
MURMUR_PUBLIC_URL=http://localhost:8080

# Webhook delivery defaults to https-only. Set to "1" if you intentionally
# want to register http:// URLs from local dev (e.g. a localhost listener).
# Leave UNSET in production — the daemon ignores anything other than "1".
WEBHOOK_ALLOW_HTTP=

# ─── Cron tickers (seconds) ───────────────────────────────────────────────
RESOLVER_TICK_SEC=30
BENCHMARK_TICK_SEC=600

# ─── Oracle (REQUIRED for resolver to actually run) ──────────────────────
# Without BASE_MAINNET_RPC_URL the daemon boots, /v1/health responds, and
# the API serves reads — but the resolver tick is disabled and no calls
# will ever transition past `pending_resolution`. Use any Base mainnet RPC.
BASE_MAINNET_RPC_URL=
# Optional override; defaults to standard Chainlink Base ETH/USD proxy
CHAINLINK_BASE_ETH_USD_ADDRESS=
PYTH_HERMES_ENDPOINT=https://hermes.pyth.network/v2/updates/price/latest

# ─── OpenServ adapter (optional) ──────────────────────────────────────────
# Opt-in via OPENSERV_VERDICT_ENABLED=true AND OPENSERV_API_KEY. Missing
# either = adapter is skipped at boot.
OPENSERV_API_KEY=
OPENSERV_AUTH_TOKEN=
OPENSERV_VERDICT_PORT=7378
OPENSERV_VERDICT_ENABLED=false

# ─── Privy (REQUIRED in production for the casual-tier claim flow) ───────
# Production wires the real Privy verifiers; dev falls back to NullVerifier
# only when CLAIM_VERIFY_BYPASS=true. Without these, /v1/claims/* will
# fail closed in production — daemon boots fine, but no agent claims work.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_VERIFICATION_KEY=

# ─── Admin / dispute resolution ───────────────────────────────────────────
# Required to access POST /v1/disputes/:id/resolve. Until token-staked
# governance ships, dispute resolution is admin-correct.
VERDICT_ADMIN_TOKEN=

# ─── Claim verifier bypass (DEV ONLY) ─────────────────────────────────────
# In production, the ClaimService fails closed unless real PostVerifiers are
# wired in (see PRIVY_* above). Set this to "true" to use the NullVerifier
# in dev — never set this in prod.
CLAIM_VERIFY_BYPASS=
NODE_ENV=

# Wave 1 — Phase E cleanup + committed-mode discovery flag + age-envelope
# recipient/identity + drand binding removed alongside the legacy
# privacy stack. Murmur runs FHE-only post-Wave 2; the env vars that
# gated the deleted modes go away with them.

# Kill switch: set to "1" to disable the v2 resolver path (universal payout
# vector) and run only the legacy price-resolver. For incident response.
MURMUR_V2_RESOLVER_DISABLED=0

# ─── Privacy: operator-blind FHE submission ──────────────────────────────
# Wave 2 (consolidated reshape) drops MURMUR_FHE_DIRECT_ENABLED — FHE-direct
# becomes the only submission mode, eager-imported at boot. The flag is
# left here documented for v=30 / earlier-stack readers; setting it has
# no effect post-Wave 2.

# Z5 production gate. When set, /v1/readyz refuses to report ready unless
# the active FHE provider reports `threshold_mode='production'`. The mock,
# stub, and mock_quorum postures are explicitly rejected — they keep the
# operator in the trust root (see Z3 + threat-model). Leave unset in
# development; flip to 1 in production deploy manifests so a misconfigured
# rollback to legacy / mock cannot silently pass health checks.
#   0 (default) — readyz passes regardless of threshold_mode
#   1           — readyz fails 503 unless threshold_mode='production'
MURMUR_PROD_REQUIRE_OPERATOR_BLIND=0

# ─── Per-benchmark HMAC keys (used by the shipped baselines) ─────────────
# Generate any random secret per benchmark slug. The daemon only authorizes
# the benchmark agent to submit calls when the secret here matches the hash
# stored in agents.api_key_hash.
BENCHMARK_KEY_murmur-momentum=
BENCHMARK_KEY_murmur-contrarian=
BENCHMARK_KEY_murmur-risk-off=

{
  "name": "murmur",
  "version": "0.1.0",
  "description": "An autonomous DeFi operator that converts social sentiment and on-chain signals into permission-gated trade execution on Base.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/daemon/index.ts",
    "start": "tsx src/daemon/index.ts",
    "build": "tsc --noEmit",
    "scout": "tsx src/scout/index.ts",
    "analyst": "tsx src/analyst/index.ts",
    "lint": "tsc --noEmit",
    "smoke": "tsx src/verdict/__smoke__.ts && tsx src/verdict/__db_smoke__.ts && tsx src/verdict/__submissions_smoke__.ts && tsx src/verdict/__resolver_smoke__.ts && tsx src/verdict/__leaderboard_smoke__.ts && tsx src/verdict/__api_smoke__.ts && tsx src/integrations/__oracle_smoke__.ts && tsx src/benchmark/__benchmark_smoke__.ts && tsx src/verdict/__shadow_claim_smoke__.ts && tsx src/integrations/__telegram_smoke__.ts && tsx src/verdict/__disputes_smoke__.ts && tsx src/verdict/__auth_smoke__.ts && tsx src/integrations/__verifiers_smoke__.ts && tsx src/daemon/__daemon_smoke__.ts",
    "smoke:contracts": "forge test --root contracts",
    "dashboard": "vite --config dashboard/vite.config.ts",
    "dashboard:build": "vite build --config dashboard/vite.config.ts",
    "mcp": "tsx src/mcp/index.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.2.7",
    "@gsap/react": "^2.1.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openserv-labs/sdk": "^2.4.1",
    "@phosphor-icons/react": "^2.1.10",
    "@rainbow-me/rainbowkit": "^2.2.10",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-query": "^5.94.5",
    "better-sqlite3": "^12.9.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "framer-motion": "^12.38.0",
    "gsap": "^3.14.2",
    "lightweight-charts": "^5.1.0",
    "node-cron": "^4.2.1",
    "tailwindcss": "^4.2.4",
    "viem": "^2.48.4",
    "wagmi": "^3.6.5",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

{
  "name": "murmur",
  "version": "0.1.0",
  "description": "Murmur Verdict — public referee + scoring layer for autonomous market-prediction agents. Calls are sealed through Fhenix, resolved against canonical market outcomes, and ranked on a leaderboard.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/daemon/index.ts",
    "start": "tsx src/daemon/index.ts",
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "smoke": "tsx src/verdict/leaderboard-general-check.ts && tsx src/verdict/controller-wallet.smoke.ts && tsx src/integrations/fhenix-events.smoke.ts && tsx src/verdict/fhenix-api.smoke.ts && tsx src/integrations/fhenix-gateway.smoke.ts && tsx src/integrations/fhenix-gateway-race.smoke.ts && tsx src/integrations/live-canaries.smoke.ts && tsx src/integrations/fhenix-watcher.smoke.ts && tsx src/integrations/operator-alerts.smoke.ts && tsx src/integrations/openserv-launchpad.smoke.ts && npm run smoke:nanopay",
    "smoke:identity": "tsx src/verdict/controller-wallet.smoke.ts",
    "smoke:fhenix": "tsx src/verdict/fhenix-api.smoke.ts",
    "smoke:fhenix-gateway": "tsx src/integrations/fhenix-gateway.smoke.ts",
    "smoke:fhenix-gateway-race": "tsx src/integrations/fhenix-gateway-race.smoke.ts",
    "smoke:canaries": "tsx src/integrations/live-canaries.smoke.ts",
    "smoke:alerts": "tsx src/integrations/operator-alerts.smoke.ts",
    "smoke:fhenix-events": "tsx src/integrations/fhenix-events.smoke.ts",
    "smoke:fhenix-watcher": "tsx src/integrations/fhenix-watcher.smoke.ts",
    "smoke:fhenix-live": "tsx src/integrations/murmur-sealed-verdicts.live-smoke.ts",
    "smoke:openserv": "tsx src/integrations/openserv-launchpad.smoke.ts",
    "smoke:nanopay": "tsx src/daemon/nanopay-runtime.smoke.ts && tsx src/verdict/nanopay-payment-gate.smoke.ts && tsx src/verdict/nanopay-settlement-surface.smoke.ts",
    "smoke:contracts": "PATH=\"$HOME/.foundry/bin:$PATH\" forge test --root contracts",
    "verify:readiness": "npm run build && npm run dashboard:build && npm run smoke && npm run smoke:contracts",
    "deploy:contracts": "PATH=\"$HOME/.foundry/bin:$PATH\" bash -c 'cd contracts && forge script script/DeployMurmurSealedVerdicts.s.sol:DeployMurmurSealedVerdicts --rpc-url \"$BASE_RPC_URL\" --broadcast -vvv && forge script script/DeployMurmurEscrow.s.sol:DeployMurmurEscrow --rpc-url \"$BASE_RPC_URL\" --broadcast -vvv'",
    "sync:deployments": "tsx src/scripts/sync-deployments.ts",
    "verify:deployments": "tsx src/scripts/verify-deployments.ts",
    "dashboard": "vite --config dashboard/vite.config.ts",
    "dashboard:build": "vite build --config dashboard/vite.config.ts",
    "verify:deploy": "tsx tools/verify/verify-deploy.ts",
    "outreach:thread": "tsx tools/operations/launch-thread.ts"
  },
  "dependencies": {
    "@circle-fin/x402-batching": "^3.0.4",
    "@cofhe/sdk": "^0.5.2",
    "@openserv-labs/sdk": "^2.4.1",
    "@privy-io/node": "^0.18.0",
    "@privy-io/react-auth": "3.23.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.2.4",
    "better-sqlite3": "^12.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.1",
    "lucide-react": "^1.17.0",
    "openai": "^5.23.2",
    "react-is": "^19.2.6",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "viem": "^2.48.4",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cofhe/foundry-plugin": "^0.5.2",
    "@cofhe/mock-contracts": "^0.5.2",
    "@fhenixprotocol/cofhe-contracts": "^0.1.3",
    "@openzeppelin/contracts": "^5.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.0",
    "playwright": "^1.50.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

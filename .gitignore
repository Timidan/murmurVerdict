*.tsbuildinfo

# Test / QA artifacts
playwright-report/
test-results/
qa-shots/
**/qa/
*.qa.html
*-screenshots/
screenshots/
*.gas-snapshot
lcov.info

# Codegen artifacts
artifacts/
typechain/
typechain-types/
crytic-export/
slither*.json

# Exploration / mockup / scratch — must never be committed.
# QA, sample HTML, throwaway scripts, mockups, ad-hoc exploration files
# don't belong in the operational tree.
*-exploration.*
*-explorations.*
*-mockup.*
*-mockups.*
*.mock.*
/tmp-*/
/scratch-*/

# Foundry
contracts/cache/
contracts/out/
contracts/broadcast/
.superpowers/

# Internal launchpad docs (strategy, ops, recruiting, screenshots, briefs)
# Master never tracked these — kept local. To publish a specific file,
# use `git add -f <path>`.
/docs/*
!/docs/superpowers/
/docs/superpowers/*
!/docs/superpowers/specs/
!/docs/superpowers/specs/**
!/docs/superpowers/plans/
!/docs/superpowers/plans/**
/OPENSERV_MEETING_BRIEF.md

# Smoke / driver scripts colocated with their modules — local-only.
# Covers both the legacy double-underscore convention (__smoke__.ts) AND
# the current per-module sibling convention (foo.smoke.ts / foo.smoke.tsx
# / foo.live-smoke.ts). Smokes are operator-runnable verification kept on
# disk but NEVER tracked — they're scaffolding, not shippable code.
**/__smoke__.ts
**/__*_smoke__.ts
**/__smoke__.tsx
**/__*_smoke__.tsx
**/*.smoke.ts
**/*.smoke.tsx
**/*.live-smoke.ts

# Local SQLite databases
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

# Claude Code session-local state
/.claude/

# Agent scaffolding directories — local-only working state, never committed.
# These hold session-local artifacts from various coding-agent tools.
/.claire/
/.agents/
/.codex/

# Raster asset pack — large binaries; brand-mark sources live under
# dashboard/public/brand/ in tracked form. Keep the source bundle local.
/murmur-verdict__full-asset-pack__final/

# Brand-mark geometry build artifacts (regeneratable from asset PNGs)
dashboard/docs/specs/*-geometry.json

# Local screen recordings / demo captures — never repo content
/*.mkv

# Stray asset-pack export at repo root (canonical wordmark is tracked at
# dashboard/public/brand/wordmark-horizontal-dark.png)
/05_murmur-verdict__wordmark-horizontal__dark.png

# Timeline-lab photo originals — large re-fetchable CC sources; provenance
# and licenses live in timeline-lab/assets/sources.json, the graded
# derivatives are tracked
dashboard/public/landing/timeline-lab/assets/raw/

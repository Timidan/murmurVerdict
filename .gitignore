# Environment & Credentials
.env
.env*
*.env
*.env.*
dashboard/.env
dashboard/.env*
!.env.example
!dashboard/.env.example

# Dependencies
node_modules/
# Also match `node_modules` as a symlink (mode 120000) — npm install in a
# fresh worktree sometimes creates dashboard/node_modules as a symlink
# back into the root tree's node_modules, and trailing-slash globs match
# directories only, not symlinks. Without this entry, the symlink itself
# gets staged on the next `git add -A`.
**/node_modules
.pnp
.pnp.js

# Build outputs
dist/
build/
out/
.next/
.nuxt/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Keys & Secrets
*.pem
*.key
*.p12
*.pfx
secrets/

# Coverage
coverage/
.nyc_output/

# Cache
.cache/
.parcel-cache/
.eslintcache
.turbo/
.vite/
.vite-temp/
.esbuild/
*.tsbuildinfo

# Test / QA artifacts
playwright-report/
test-results/
qa-shots/
**/qa/
*.qa.html
*-screenshots/
screenshots/
*.gas-snapshot
lcov.info

# Codegen artifacts
artifacts/
typechain/
typechain-types/
crytic-export/
slither*.json

# Exploration / mockup / scratch — must never be committed.
# QA, sample HTML, throwaway scripts, mockups, ad-hoc exploration files
# don't belong in the operational tree.
*-exploration.*
*-explorations.*
*-mockup.*
*-mockups.*
*.mock.*
/tmp-*/
/scratch-*/

# Foundry
contracts/cache/
contracts/out/
contracts/broadcast/
.superpowers/

# Internal launchpad docs (strategy, ops, recruiting, screenshots, briefs)
# Master never tracked these — kept local. To publish a specific file,
# use `git add -f <path>`.
/docs/*
!/docs/superpowers/
/docs/superpowers/*
!/docs/superpowers/specs/
!/docs/superpowers/specs/**
!/docs/superpowers/plans/
!/docs/superpowers/plans/**
/OPENSERV_MEETING_BRIEF.md

# Smoke / driver scripts colocated with their modules — local-only.
**/__smoke__.ts
**/__*_smoke__.ts
**/__smoke__.tsx
**/__*_smoke__.tsx

# Local SQLite databases
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

# Claude Code session-local state
/.claude/

# Example agent template — runtime artifacts (generated at claim-time)
examples/external-agent/.env
examples/external-agent/.agent-state.json
examples/external-agent/node_modules/

# Brand-mark geometry build artifacts (regeneratable from asset PNGs)
dashboard/docs/specs/*-geometry.json
